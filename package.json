{
  "name": "flexi-day-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace repo for the four Flexi Day repos: shared agent skills, dev tooling and cross-repo docs. Scripts delegate into each sub-repo via `pnpm -C`.",
  "scripts": {
    "check": "pnpm run format:check && pnpm run lint && pnpm run check:links && pnpm run check:shell && pnpm run check:actions",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:links": "node tools/check-links.mjs",
    "check:shell": "if command -v shellcheck >/dev/null 2>&1; then find tools -name \"*.sh\" -exec shellcheck {} +; else echo \"shellcheck not installed, skipping (CI runs it)\"; fi",
    "check:actions": "if command -v actionlint >/dev/null 2>&1; then actionlint; else echo \"actionlint not installed, skipping (CI runs it)\"; fi",
    "install:all": "tools/install-all.sh",
    "dev:be": "pnpm -C ./flexi-day-be run dev",
    "dev:fe": "pnpm -C ./flexi-day run dev",
    "dev:emails": "pnpm -C ./flexi-day-emails run dev",
    "dev:rn": "pnpm -C ./flexi-day-rn run start",
    "build:be": "pnpm -C ./flexi-day-be run build",
    "build:fe": "pnpm -C ./flexi-day run build",
    "build:emails": "pnpm -C ./flexi-day-emails run build",
    "start:be": "pnpm -C ./flexi-day-be run start",
    "test:be": "pnpm -C ./flexi-day-be run test",
    "test:fe": "pnpm -C ./flexi-day run test",
    "test:rn": "pnpm -C ./flexi-day-rn run test",
    "lint:be": "pnpm -C ./flexi-day-be run lint",
    "lint:fe": "pnpm -C ./flexi-day run lint",
    "lint:rn": "pnpm -C ./flexi-day-rn run lint",
    "typecheck:emails": "pnpm -C ./flexi-day-emails run typecheck",
    "typecheck:rn": "pnpm -C ./flexi-day-rn run typecheck",
    "format:be": "pnpm -C ./flexi-day-be run format",
    "format:fe": "pnpm -C ./flexi-day run format",
    "format:emails": "pnpm -C ./flexi-day-emails run format",
    "format:rn": "pnpm -C ./flexi-day-rn run format",
    "format:check:be": "pnpm -C ./flexi-day-be run format:check",
    "format:check:fe": "pnpm -C ./flexi-day run format:check",
    "format:check:emails": "pnpm -C ./flexi-day-emails run format:check",
    "format:check:rn": "pnpm -C ./flexi-day-rn run format:check",
    "db:migrate": "pnpm -C ./flexi-day-be run db:migrate",
    "db:generate": "pnpm -C ./flexi-day-be run db:generate",
    "db:up": "docker start flexi-day-pg 2>/dev/null || docker run -d --name flexi-day-pg -p 5432:5432 -e POSTGRES_USER=$USER -e POSTGRES_DB=flexi-day -e POSTGRES_HOST_AUTH_METHOD=trust postgres:15",
    "db:down": "docker stop flexi-day-pg",
    "stack:up": "pnpm run db:migrate && (pnpm run dev:be & pnpm run dev:fe & wait)",
    "stack:start": "tools/stack.sh start",
    "stack:stop": "tools/stack.sh stop",
    "stack:logs": "tools/stack.sh logs",
    "stack:status": "node tools/dev-cli.mjs status",
    "dev:status": "node tools/dev-cli.mjs status",
    "dev:seed": "node tools/dev-cli.mjs seed",
    "dev:scenario": "node tools/dev-cli.mjs scenario",
    "dev:login": "node tools/dev-cli.mjs login",
    "dev:login:rn": "node tools/dev-cli.mjs login:rn",
    "dev:reset": "node tools/dev-cli.mjs reset",
    "dev:calendar:connect": "node tools/dev-cli.mjs calendar:connect",
    "dev:calendar:events": "node tools/dev-cli.mjs calendar:events",
    "dev:calendar:capability": "node tools/dev-cli.mjs calendar:capability"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/mcp": "^0.0.84",
    "@sentry/cli": "^3.8.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "3.9.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daniel88dev/flexi-day-workspace.git"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
